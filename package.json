{
  "name": "waymark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-static.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3847",
    "build": "node scripts/prepare-static.mjs && next build",
    "build:pages": "node scripts/prepare-static.mjs && NEXT_PUBLIC_BASE_PATH=/waymark next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp": "node scripts/build-mcp.mjs && node dist/waymark-mcp.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "@googlemaps/js-api-loader": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.70.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "fake-indexeddb": "^6.2.7",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
