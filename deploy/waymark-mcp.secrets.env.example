# Copy to ~/.config/waymark-mcp/secrets.env
# chmod 600. Do not commit the filled file. Do not symlink it.
MCP_BEARER_TOKEN=
MCP_LISTEN=127.0.0.1:8793
WAYMARK_TAILNET_LISTEN=127.0.0.1:8794
MCP_PUBLIC_ORIGIN=https://your-machine.tailnet.ts.net:10000
WAYMARK_DATA_FILE=/Users/you/.local/share/waymark-mcp/sessions.json
# Browser origins allowed to call the tailnet API. Comma-separated, no paths.
WAYMARK_UI_ORIGINS=http://127.0.0.1:3847,http://localhost:3847
