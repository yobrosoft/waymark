<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.joel.waymark-mcp</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/you/.local/libexec/waymark-mcp/waymark-mcp.mjs</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>WAYMARK_MCP_SECRETS_FILE</key>
		<string>/Users/you/.config/waymark-mcp/secrets.env</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/you/Library/Logs/waymark-mcp/stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/you/Library/Logs/waymark-mcp/stderr.log</string>
	<key>WorkingDirectory</key>
	<string>/var/empty</string>
</dict>
</plist>
